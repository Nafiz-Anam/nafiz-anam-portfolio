# --- Postgres ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=portfolio
DATABASE_URL=postgresql://portfolio:changeme@localhost:5432/portfolio

# --- apps/api ---
API_PORT=4000
CORS_ORIGIN_WEB=http://localhost:3000
CORS_ORIGIN_CMS=http://localhost:3001

# auth: separate secrets for access vs refresh tokens (never reuse one for both)
ACCESS_TOKEN_SECRET=changeme-access-min-32-chars-random-string
REFRESH_TOKEN_SECRET=changeme-refresh-min-32-chars-random-string
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL=30d

# uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# email notifications (contact form leads) — optional, form still saves to DB without it
# works with any SMTP provider (Gmail App Password, SendGrid, Mailgun SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com
NOTIFY_EMAIL=you@gmail.com

# db seed (creates one admin user via `pnpm --filter @portfolio/db exec prisma db seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-min-8-chars

# On-demand ISR revalidation — API calls this to flush Next.js cache after CMS mutations
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=changeme-generate-secret
WEB_URL=http://localhost:3000

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://nafizanam.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
REVALIDATE_SECRET=changeme-generate-secret
# Exposed to CMS browser for draft preview links — use same value as REVALIDATE_SECRET
NEXT_PUBLIC_PREVIEW_SECRET=changeme-generate-secret

# Google Calendar booking system
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/google-calendar/callback (adjust for prod)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google-calendar/callback

# 32-byte hex key for AES-256-GCM encryption of Google refresh tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=changeme-generate-32-byte-hex-key-here

# Booking settings (can also be managed via CMS Settings page)
BOOKING_TIMEZONE=Europe/London
BOOKING_SLOT_MINS=30
BOOKING_START_HOUR=9
BOOKING_END_HOUR=18
BOOKING_BUFFER_MINS=15

# --- apps/cms ---
NEXT_PUBLIC_API_URL_CMS=http://localhost:4000
